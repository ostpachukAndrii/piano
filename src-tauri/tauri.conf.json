{
    "productName": "Piano Lesson App",
    "version": "0.1.0",
    "identifier": "com.example.pianolesson",
    "build": {
        "beforeBuildCommand": "powershell -Command \"cd ../src; npm run build\"",
        "beforeDevCommand": "powershell -Command \"cd ../src; npm start\"",
        "devUrl": "http://localhost:4200",
        "frontendDist": "../src/dist/piano-app/browser"
    },
    "app": {
        "windows": [
            {
                "title": "Piano Lesson App",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "msi",
            "nsis"
        ]
    }
}