<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🎹 Piano Learning App - Phase 4</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: white;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        h1 {
            font-size: 2.5rem;
            margin: 0.5rem 0;
        }

        .api-status {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 12px;
            font-size: 0.8rem;
            margin-left: 1rem;
        }

        .api-status.connected {
            background: #22c55e;
            color: white;
        }

        .api-status.disconnected {
            background: #ef4444;
            color: white;
        }

        .api-status.loading {
            background: #f59e0b;
            color: white;
        }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem;
        }

        .lesson-selector {
            margin-bottom: 1.5rem;
            display: flex;
            gap: 1rem;
            align-items: center;
            flex-wrap: wrap;
            justify-content: center;
        }

        .lesson-selector select {
            padding: 0.5rem 1rem;
            font-size: 1rem;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        .lesson-stage {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            max-width: 1400px;
            width: 100%;
        }

        .lesson-header {
            margin-bottom: 2rem;
            text-align: center;
        }

        .lesson-header h2 {
            font-size: 2rem;
            color: #333;
            margin-bottom: 0.5rem;
        }

        .lesson-header p {
            color: #666;
            font-size: 1.1rem;
        }

        .grand-staff-container {
            overflow-x: auto;
            margin: 2rem 0;
        }

        .grand-staff-svg {
            min-width: 800px;
            height: auto;
            background: white;
        }

        .lesson-footer {
            text-align: center;
            margin-top: 2rem;
            color: #666;
            font-size: 0.95rem;
            display: flex;
            gap: 2rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .lesson-footer p {
            margin: 0.25rem 0;
        }

        .stat-badge {
            background: #f3f4f6;
            padding: 0.5rem 1rem;
            border-radius: 8px;
        }

        .loading {
            text-align: center;
            padding: 3rem;
            color: #666;
        }

        .error {
            text-align: center;
            padding: 3rem;
            color: #ef4444;
        }

        /* Chord labels */
        .chord-label {
            font-family: Georgia, serif;
            font-size: 14px;
            font-weight: bold;
        }

        /* Note styling for hover effects */
        .note-head:hover {
            fill: #3b82f6;
            cursor: pointer;
        }

        /* MIDI Controls */
        .midi-panel {
            background: #1f2937;
            color: white;
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            gap: 2rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .midi-controls {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .midi-controls select,
        .midi-controls button {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-size: 0.9rem;
            border: none;
        }

        .midi-controls select {
            background: white;
            color: #333;
            min-width: 200px;
        }

        .midi-controls button {
            background: #22c55e;
            color: white;
            cursor: pointer;
            transition: background 0.2s;
        }

        .midi-controls button:hover {
            background: #16a34a;
        }

        .midi-controls button:disabled {
            background: #6b7280;
            cursor: not-allowed;
        }

        .midi-controls button.disconnect {
            background: #ef4444;
        }

        .midi-controls button.disconnect:hover {
            background: #dc2626;
        }

        .midi-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .midi-status .indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #ef4444;
        }

        .midi-status .indicator.connected {
            background: #22c55e;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        /* Active Notes Display */
        .active-notes {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            min-height: 32px;
            align-items: center;
        }

        .active-note {
            background: #3b82f6;
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 16px;
            font-size: 0.85rem;
            font-weight: 500;
            animation: noteIn 0.15s ease-out;
        }

        @keyframes noteIn {
            from {
                transform: scale(0.8);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .note-highlight {
            fill: #22c55e;
            stroke: #16a34a;
            stroke-width: 2;
        }

        /* Practice Mode Styles */
        .practice-panel {
            background: linear-gradient(135deg, #1e3a5f 0%, #0d1b2a 100%);
            color: white;
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            gap: 2rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .practice-controls {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .practice-controls button {
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .practice-controls button.start {
            background: #22c55e;
            color: white;
        }

        .practice-controls button.start:hover {
            background: #16a34a;
        }

        .practice-controls button.stop {
            background: #ef4444;
            color: white;
        }

        .practice-controls button.stop:hover {
            background: #dc2626;
        }

        .practice-controls button:disabled {
            background: #6b7280;
            cursor: not-allowed;
        }

        .progress-container {
            flex: 1;
            max-width: 400px;
            min-width: 200px;
        }

        .progress-bar {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            height: 20px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            background: linear-gradient(90deg, #22c55e, #4ade80);
            height: 100%;
            width: 0%;
            transition: width 0.3s ease;
            border-radius: 10px;
        }

        .progress-text {
            text-align: center;
            margin-top: 0.5rem;
            font-size: 0.85rem;
            opacity: 0.9;
        }

        .practice-stats {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .practice-stat {
            text-align: center;
        }

        .practice-stat .value {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .practice-stat .label {
            font-size: 0.75rem;
            opacity: 0.8;
            text-transform: uppercase;
        }

        /* Current note indicator */
        .note-current {
            fill: #3b82f6 !important;
            stroke: #1d4ed8 !important;
            stroke-width: 3 !important;
            filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6));
        }

        /* Correct note feedback */
        .note-correct {
            fill: #22c55e !important;
            stroke: #16a34a !important;
            stroke-width: 2 !important;
            animation: correctPulse 0.5s ease-out;
        }

        @keyframes correctPulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.2);
            }

            100% {
                transform: scale(1);
            }
        }

        /* Wrong note feedback */
        .note-wrong {
            fill: #ef4444 !important;
            stroke: #dc2626 !important;
            stroke-width: 2 !important;
            animation: wrongShake 0.3s ease-out;
        }

        @keyframes wrongShake {

            0%,
            100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }

        /* Feedback toast */
        .feedback-toast {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 2rem 3rem;
            border-radius: 16px;
            font-size: 2rem;
            font-weight: 700;
            z-index: 1000;
            animation: toastIn 0.3s ease-out;
            pointer-events: none;
        }

        .feedback-toast.correct {
            background: #22c55e;
            color: white;
        }

        .feedback-toast.wrong {
            background: #ef4444;
            color: white;
        }

        @keyframes toastIn {
            from {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.5);
            }

            to {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
            }
        }

        /* Expected notes display */
        .expected-notes {
            background: rgba(59, 130, 246, 0.1);
            border: 2px solid #3b82f6;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .expected-notes .label {
            font-size: 0.8rem;
            opacity: 0.8;
        }

        .expected-notes .notes {
            display: flex;
            gap: 0.5rem;
        }

        .expected-note {
            background: #3b82f6;
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 16px;
            font-size: 0.9rem;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <header>
        <h1>🎹 Piano Learning App</h1>
        <p>
            Phase 6: Interactive Practice
            <span id="api-status" class="api-status loading">Connecting...</span>
        </p>
    </header>

    <!-- Practice Mode Panel -->
    <div class="practice-panel">
        <div class="practice-controls">
            <button id="practice-start-btn" class="start" disabled>▶️ Start Practice</button>
            <button id="practice-stop-btn" class="stop" style="display: none;">⏹️ Stop</button>
        </div>

        <div class="progress-container">
            <div class="progress-bar">
                <div class="progress-fill" id="progress-fill"></div>
            </div>
            <div class="progress-text" id="progress-text">Ready to practice</div>
        </div>

        <div class="expected-notes" id="expected-notes" style="display: none;">
            <span class="label">Play:</span>
            <div class="notes" id="expected-notes-list"></div>
        </div>

        <div class="practice-stats">
            <div class="practice-stat">
                <div class="value" id="stat-correct">0</div>
                <div class="label">Correct</div>
            </div>
            <div class="practice-stat">
                <div class="value" id="stat-wrong">0</div>
                <div class="label">Wrong</div>
            </div>
            <div class="practice-stat">
                <div class="value" id="stat-accuracy">--%</div>
                <div class="label">Accuracy</div>
            </div>
        </div>
    </div>

    <!-- MIDI Control Panel -->
    <div class="midi-panel">
        <div class="midi-status">
            <span class="indicator" id="midi-indicator"></span>
            <span id="midi-status-text">No MIDI device</span>
        </div>

        <div class="midi-controls">
            <select id="midi-device-select" disabled>
                <option value="">Select MIDI device...</option>
            </select>
            <button id="midi-connect-btn" disabled>Connect</button>
            <button id="midi-refresh-btn">🔄 Refresh</button>
        </div>

        <div class="active-notes" id="active-notes">
            <!-- Active notes will appear here -->
        </div>
    </div>

    <main>
        <div class="lesson-selector">
            <label for="lesson-select">Select Lesson:</label>
            <select id="lesson-select" disabled>
                <option value="">Loading lessons...</option>
            </select>
        </div>

        <div class="lesson-stage">
            <div id="lesson-content" class="loading">Loading lesson...</div>
        </div>
    </main>

    <script>
        // ============================================
        // API CONFIGURATION
        // ============================================
        const API_BASE_URL = 'http://localhost:8080/api/v1';
        const WS_BASE_URL = 'ws://localhost:8080';
        let apiConnected = false;
        let lessonCache = {};

        // ============================================
        // MIDI STATE
        // ============================================
        let midiWebSocket = null;
        let midiConnected = false;
        let activeNotes = new Map(); // midi number -> timestamp
        let midiDevices = [];

        // ============================================
        // PRACTICE MODE STATE
        // ============================================
        let practiceActive = false;
        let currentLesson = null;
        let currentEventIndex = 0;
        let practiceStats = { correct: 0, wrong: 0 };
        let lessonNoteEvents = []; // Flattened list of note events to practice
        let chordGroupTimeout = null;
        const CHORD_GROUP_DELAY = 50; // ms to group chord notes

        // ============================================
        // PRACTICE MODE FUNCTIONS
        // ============================================

        // Extract note events from lesson for practice
        function extractNoteEvents(lesson) {
            if (!lesson || !lesson.measures) return [];

            const events = [];
            let eventIndex = 0;

            for (const measure of lesson.measures) {
                for (const note of measure.notes) {
                    const isChord = Array.isArray(note.midi);
                    events.push({
                        index: eventIndex++,
                        midi: isChord ? note.midi : [note.midi],
                        duration: note.duration,
                        chord: note.chord || null,
                        played: false
                    });
                }
            }

            return events;
        }

        // Start practice mode
        function startPractice() {
            if (!currentLesson || !midiConnected) {
                alert('Please connect a MIDI device and load a lesson first.');
                return;
            }

            practiceActive = true;
            currentEventIndex = 0;
            practiceStats = { correct: 0, wrong: 0 };
            lessonNoteEvents = extractNoteEvents(currentLesson);

            // Update UI
            document.getElementById('practice-start-btn').style.display = 'none';
            document.getElementById('practice-stop-btn').style.display = 'inline-block';
            document.getElementById('expected-notes').style.display = 'flex';

            updatePracticeUI();
            highlightCurrentNote();

            console.log('🎵 Practice started! Events:', lessonNoteEvents.length);
        }

        // Stop practice mode
        function stopPractice() {
            practiceActive = false;

            // Update UI
            document.getElementById('practice-start-btn').style.display = 'inline-block';
            document.getElementById('practice-stop-btn').style.display = 'none';
            document.getElementById('expected-notes').style.display = 'none';

            // Clear highlights
            clearAllNoteHighlights();

            // Show final stats
            const total = practiceStats.correct + practiceStats.wrong;
            const accuracy = total > 0 ? Math.round((practiceStats.correct / total) * 100) : 0;
            document.getElementById('progress-text').textContent =
                `Practice complete! ${practiceStats.correct}/${total} correct (${accuracy}%)`;

            console.log('⏹️ Practice stopped');
        }

        // Update practice UI (progress, stats, expected notes)
        function updatePracticeUI() {
            const total = lessonNoteEvents.length;
            const progress = total > 0 ? (currentEventIndex / total) * 100 : 0;

            // Update progress bar
            document.getElementById('progress-fill').style.width = `${progress}%`;
            document.getElementById('progress-text').textContent =
                `Note ${currentEventIndex + 1} of ${total}`;

            // Update stats
            document.getElementById('stat-correct').textContent = practiceStats.correct;
            document.getElementById('stat-wrong').textContent = practiceStats.wrong;

            const totalAttempts = practiceStats.correct + practiceStats.wrong;
            const accuracy = totalAttempts > 0
                ? Math.round((practiceStats.correct / totalAttempts) * 100)
                : 0;
            document.getElementById('stat-accuracy').textContent = `${accuracy}%`;

            // Update expected notes display
            if (currentEventIndex < lessonNoteEvents.length) {
                const currentEvent = lessonNoteEvents[currentEventIndex];
                const notesList = document.getElementById('expected-notes-list');
                notesList.innerHTML = currentEvent.midi
                    .map(m => `<span class="expected-note">${midiToNoteName(m)}</span>`)
                    .join('');
            }
        }

        // Highlight current note on the staff
        function highlightCurrentNote() {
            // Clear previous highlights
            document.querySelectorAll('.note-current').forEach(el => {
                el.classList.remove('note-current');
            });

            if (currentEventIndex >= lessonNoteEvents.length) return;

            const currentEvent = lessonNoteEvents[currentEventIndex];

            // Find and highlight the note heads for current event
            // We need to match by position (nth occurrence of this MIDI)
            const midiNumbers = currentEvent.midi;

            // Count occurrences to find the right note
            let occurrences = {};
            midiNumbers.forEach(midi => {
                occurrences[midi] = (occurrences[midi] || 0);
            });

            // Find all notes with matching MIDI and highlight based on event index
            midiNumbers.forEach(midi => {
                const noteHeads = document.querySelectorAll(`[data-midi="${midi}"][data-event="${currentEventIndex}"]`);
                noteHeads.forEach(head => head.classList.add('note-current'));
            });

            // Fallback: if data-event not set, highlight all matching MIDI notes
            if (document.querySelectorAll('.note-current').length === 0) {
                midiNumbers.forEach(midi => {
                    const noteHeads = document.querySelectorAll(`[data-midi="${midi}"]`);
                    // Highlight the (currentEventIndex)th occurrence
                    let count = 0;
                    noteHeads.forEach(head => {
                        // Simple heuristic: just highlight first matching
                        if (count === 0) {
                            head.classList.add('note-current');
                        }
                        count++;
                    });
                });
            }
        }

        // Clear all note highlights
        function clearAllNoteHighlights() {
            document.querySelectorAll('.note-current, .note-correct, .note-wrong').forEach(el => {
                el.classList.remove('note-current', 'note-correct', 'note-wrong');
            });
        }

        // Check if played notes match expected notes
        function checkPlayedNotes() {
            if (!practiceActive || currentEventIndex >= lessonNoteEvents.length) return;

            const currentEvent = lessonNoteEvents[currentEventIndex];
            const expectedMidi = new Set(currentEvent.midi);
            const playedMidi = new Set(activeNotes.keys());

            // Check for match
            const isCorrect =
                expectedMidi.size === playedMidi.size &&
                [...expectedMidi].every(m => playedMidi.has(m));

            if (isCorrect) {
                // Correct!
                practiceStats.correct++;
                showFeedback(true);
                markNoteCorrect(currentEvent.midi);

                // Advance to next event
                currentEventIndex++;

                if (currentEventIndex >= lessonNoteEvents.length) {
                    // Lesson complete!
                    setTimeout(() => {
                        stopPractice();
                        showCompletionMessage();
                    }, 500);
                } else {
                    updatePracticeUI();
                    setTimeout(highlightCurrentNote, 300);
                }
            } else if (playedMidi.size > 0 && !hasOverlap(expectedMidi, playedMidi)) {
                // Wrong notes pressed (no overlap with expected)
                practiceStats.wrong++;
                showFeedback(false);
                markNoteWrong([...playedMidi]);
                updatePracticeUI();
            }
        }

        // Check if two sets have any overlap
        function hasOverlap(set1, set2) {
            for (const item of set1) {
                if (set2.has(item)) return true;
            }
            return false;
        }

        // Show visual feedback toast
        function showFeedback(isCorrect) {
            const toast = document.createElement('div');
            toast.className = `feedback-toast ${isCorrect ? 'correct' : 'wrong'}`;
            toast.textContent = isCorrect ? '✓ Perfect!' : '✗ Try Again';
            document.body.appendChild(toast);

            setTimeout(() => toast.remove(), 800);
        }

        // Mark notes as correct on the staff
        function markNoteCorrect(midiNumbers) {
            midiNumbers.forEach(midi => {
                document.querySelectorAll(`[data-midi="${midi}"].note-current`).forEach(el => {
                    el.classList.remove('note-current');
                    el.classList.add('note-correct');
                });
            });
        }

        // Mark notes as wrong on the staff
        function markNoteWrong(midiNumbers) {
            midiNumbers.forEach(midi => {
                document.querySelectorAll(`[data-midi="${midi}"]`).forEach(el => {
                    el.classList.add('note-wrong');
                    setTimeout(() => el.classList.remove('note-wrong'), 500);
                });
            });
        }

        // Show completion message
        function showCompletionMessage() {
            const total = practiceStats.correct + practiceStats.wrong;
            const accuracy = total > 0 ? Math.round((practiceStats.correct / total) * 100) : 100;

            const toast = document.createElement('div');
            toast.className = 'feedback-toast correct';
            toast.innerHTML = `🎉 Lesson Complete!<br><small>${accuracy}% Accuracy</small>`;
            toast.style.fontSize = '1.5rem';
            document.body.appendChild(toast);

            setTimeout(() => toast.remove(), 3000);
        }

        // Initialize practice controls
        function initPracticeControls() {
            document.getElementById('practice-start-btn').addEventListener('click', startPractice);
            document.getElementById('practice-stop-btn').addEventListener('click', stopPractice);
        }

        // Enable/disable practice button based on MIDI connection
        function updatePracticeButtonState() {
            const btn = document.getElementById('practice-start-btn');
            btn.disabled = !midiConnected || !currentLesson;
        }

        // ============================================
        // MIDI FUNCTIONS
        // ============================================

        // Fetch available MIDI devices
        async function fetchMidiDevices() {
            try {
                const response = await fetch(`${API_BASE_URL}/midi/devices`);
                if (response.ok) {
                    midiDevices = await response.json();
                    updateMidiDeviceSelect();
                    return midiDevices;
                } else {
                    console.error('Failed to fetch MIDI devices');
                    return [];
                }
            } catch (error) {
                console.error('Error fetching MIDI devices:', error);
                return [];
            }
        }

        // Update the MIDI device dropdown
        function updateMidiDeviceSelect() {
            const select = document.getElementById('midi-device-select');
            select.innerHTML = '<option value="">Select MIDI device...</option>';

            midiDevices.forEach(device => {
                const option = document.createElement('option');
                option.value = device.index;
                option.textContent = device.name;
                select.appendChild(option);
            });

            select.disabled = midiDevices.length === 0;
            document.getElementById('midi-connect-btn').disabled = true;
        }

        // Connect to selected MIDI device
        async function connectMidiDevice(retryAfterDisconnect = false) {
            const select = document.getElementById('midi-device-select');
            const deviceIndex = parseInt(select.value);

            if (isNaN(deviceIndex)) return;

            const btn = document.getElementById('midi-connect-btn');
            btn.disabled = true;
            btn.textContent = 'Connecting...';

            try {
                const response = await fetch(`${API_BASE_URL}/midi/connect`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ device_index: deviceIndex })
                });

                if (response.ok) {
                    const result = await response.json();
                    console.log('MIDI connected:', result);
                    midiConnected = true;
                    updateMidiStatus(true, result.device_name);
                    connectMidiWebSocket();

                    btn.textContent = 'Disconnect';
                    btn.classList.add('disconnect');
                    btn.disabled = false;
                    select.disabled = true;
                } else {
                    const error = await response.json();
                    console.error('Failed to connect:', error);

                    // If port is already allocated, try disconnecting first and retry
                    if (!retryAfterDisconnect && error.error && error.error.includes('ALLOCATED')) {
                        console.log('Port allocated, attempting disconnect and retry...');
                        await fetch(`${API_BASE_URL}/midi/disconnect`, { method: 'POST' });
                        await new Promise(resolve => setTimeout(resolve, 500)); // Wait for port release
                        return connectMidiDevice(true); // Retry once
                    }

                    btn.textContent = 'Connect';
                    btn.disabled = false;
                }
            } catch (error) {
                console.error('Error connecting to MIDI:', error);
                btn.textContent = 'Connect';
                btn.disabled = false;
            }
        }

        // Disconnect from MIDI device
        async function disconnectMidiDevice() {
            try {
                await fetch(`${API_BASE_URL}/midi/disconnect`, { method: 'POST' });

                if (midiWebSocket) {
                    midiWebSocket.close();
                    midiWebSocket = null;
                }

                midiConnected = false;
                activeNotes.clear();
                updateActiveNotesDisplay();
                updateMidiStatus(false);

                const btn = document.getElementById('midi-connect-btn');
                btn.textContent = 'Connect';
                btn.classList.remove('disconnect');
                btn.disabled = true;

                document.getElementById('midi-device-select').disabled = false;
            } catch (error) {
                console.error('Error disconnecting:', error);
            }
        }

        // Connect to MIDI WebSocket for real-time events
        function connectMidiWebSocket() {
            if (midiWebSocket) {
                midiWebSocket.close();
            }

            midiWebSocket = new WebSocket(`${WS_BASE_URL}/ws/midi`);

            midiWebSocket.onopen = () => {
                console.log('🎹 MIDI WebSocket connected');
            };

            midiWebSocket.onmessage = (event) => {
                const data = JSON.parse(event.data);
                handleMidiEvent(data);
            };

            midiWebSocket.onclose = () => {
                console.log('🎹 MIDI WebSocket closed');
            };

            midiWebSocket.onerror = (error) => {
                console.error('MIDI WebSocket error:', error);
            };
        }

        // Handle incoming MIDI events
        function handleMidiEvent(data) {
            if (data.type !== 'midi_event') return;

            if (data.event_type === 'note_on' && data.velocity > 0) {
                activeNotes.set(data.note, { velocity: data.velocity, timestamp: data.timestamp });
                highlightNoteOnStaff(data.note, true);

                // In practice mode, check notes with chord grouping delay
                if (practiceActive) {
                    clearTimeout(chordGroupTimeout);
                    chordGroupTimeout = setTimeout(checkPlayedNotes, CHORD_GROUP_DELAY);
                }
            } else if (data.event_type === 'note_off' || (data.event_type === 'note_on' && data.velocity === 0)) {
                activeNotes.delete(data.note);
                highlightNoteOnStaff(data.note, false);
            }

            updateActiveNotesDisplay();
        }

        // Update the active notes display
        function updateActiveNotesDisplay() {
            const container = document.getElementById('active-notes');
            container.innerHTML = '';

            if (activeNotes.size === 0) {
                container.innerHTML = '<span style="opacity: 0.5; font-size: 0.85rem;">Play some notes...</span>';
                return;
            }

            // Sort notes by MIDI number
            const sortedNotes = [...activeNotes.keys()].sort((a, b) => a - b);

            sortedNotes.forEach(midi => {
                const noteName = midiToNoteName(midi);
                const noteEl = document.createElement('span');
                noteEl.className = 'active-note';
                noteEl.textContent = noteName;
                container.appendChild(noteEl);
            });
        }

        // Convert MIDI number to note name
        function midiToNoteName(midi) {
            const noteNames = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
            const noteName = noteNames[midi % 12];
            const octave = Math.floor(midi / 12) - 1;
            return `${noteName}${octave}`;
        }

        // Highlight a note on the staff when played
        function highlightNoteOnStaff(midiNumber, isActive) {
            // Find all note heads with this MIDI number
            const noteHeads = document.querySelectorAll(`[data-midi="${midiNumber}"]`);
            noteHeads.forEach(head => {
                if (isActive) {
                    head.classList.add('note-highlight');
                } else {
                    head.classList.remove('note-highlight');
                }
            });
        }

        // Update MIDI status display
        function updateMidiStatus(connected, deviceName = null) {
            const indicator = document.getElementById('midi-indicator');
            const statusText = document.getElementById('midi-status-text');

            if (connected) {
                indicator.classList.add('connected');
                statusText.textContent = deviceName || 'Connected';
            } else {
                indicator.classList.remove('connected');
                statusText.textContent = 'No MIDI device';
            }

            // Update practice button state
            updatePracticeButtonState();
        }

        // Initialize MIDI controls
        function initMidiControls() {
            const select = document.getElementById('midi-device-select');
            const connectBtn = document.getElementById('midi-connect-btn');
            const refreshBtn = document.getElementById('midi-refresh-btn');

            // Enable connect button when device is selected
            select.addEventListener('change', () => {
                connectBtn.disabled = select.value === '';
            });

            // Connect/disconnect toggle
            connectBtn.addEventListener('click', () => {
                if (midiConnected) {
                    disconnectMidiDevice();
                } else {
                    connectMidiDevice();
                }
            });

            // Refresh device list
            refreshBtn.addEventListener('click', () => {
                fetchMidiDevices();
            });

            // Initial fetch
            fetchMidiDevices();
        }

        // ============================================
        // MEASURE CALCULATOR (JavaScript port of Rust logic)
        // Implements bar line logic per Project_Specification v1.8
        // ============================================
        class MeasureCalculator {
            constructor(xStart = 140, xPerBeat = 60) {
                this.currentMeasureDuration = 0;
                this.currentMeasureNumber = 1;
                this.barLines = [];
                this.beatsPerMeasure = 4.0;
                this.xPosition = xStart;
                this.xSpacingPerBeat = xPerBeat;
            }

            addNote(duration) {
                this.xPosition += duration * this.xSpacingPerBeat;
                this.currentMeasureDuration += duration;

                if (this.currentMeasureDuration >= this.beatsPerMeasure) {
                    const barLine = {
                        measureNumber: this.currentMeasureNumber,
                        xPosition: this.xPosition
                    };
                    this.barLines.push(barLine);
                    this.currentMeasureDuration = 0;
                    this.currentMeasureNumber++;
                    return barLine;
                }
                return null;
            }

            addChord(durations) {
                if (durations.length === 0) return null;
                // CHORD EXCEPTION: Use max duration, not sum
                const chordDuration = Math.max(...durations);
                return this.addNote(chordDuration);
            }

            getCurrentX() {
                return this.xPosition;
            }
        }

        // ============================================
        // MIDI TO Y POSITION CONVERSION
        // Based on Project_Specification.md Section 3.6
        // ============================================
        function midiToY(midi, clef = 'treble') {
            // Staff spacing: 10px per line/space (20px between lines)
            // Lines are at Y: 40, 60, 80, 100, 120 (top to bottom)
            // Spaces are at Y: 50, 70, 90, 110 (between lines)

            if (clef === 'treble') {
                // Treble clef reference points:
                // Line 1 (bottom, Y=120): E4 (MIDI 64)
                // Line 2 (Y=100): G4 (MIDI 67) - Sol
                // Space 2 (Y=90): A4 (MIDI 69) - La
                // Line 3 (Y=80): B4 (MIDI 71)
                // Middle C (C4, MIDI 60) is at Y=130 (ledger line below staff)

                // Calculate staff position (0 = E4, each step = half a space = 10px)
                // Note names cycle: C D E F G A B (white keys)
                // MIDI 60=C4, 62=D4, 64=E4, 65=F4, 67=G4, 69=A4, 71=B4, 72=C5...

                // Map MIDI to staff position relative to E4 (MIDI 64)
                const notePositions = {
                    0: 0,   // C
                    1: 0,   // C#
                    2: 1,   // D
                    3: 1,   // D#
                    4: 2,   // E (reference)
                    5: 3,   // F
                    6: 3,   // F#
                    7: 4,   // G
                    8: 4,   // G#
                    9: 5,   // A
                    10: 5,  // A#
                    11: 6   // B
                };

                const noteInOctave = midi % 12;
                const octave = Math.floor(midi / 12) - 1;
                const octave4 = 4; // E4 is our reference at Y=120

                // Position within octave (0-6 for C through B)
                const posInOctave = notePositions[noteInOctave];

                // E4 (MIDI 64) is at position 2 in octave 4, Y=120
                // Each octave spans 7 positions (C D E F G A B)
                const e4Position = 2 + (octave4 * 7); // E4's absolute position
                const notePosition = posInOctave + (octave * 7);
                const stepsFromE4 = notePosition - e4Position;

                return 120 - (stepsFromE4 * 10);
            } else {
                // Bass clef: G2 (MIDI 43) is on line 1 at Y=120
                const notePositions = {
                    0: 0, 1: 0, 2: 1, 3: 1, 4: 2, 5: 3, 6: 3, 7: 4, 8: 4, 9: 5, 10: 5, 11: 6
                };

                const noteInOctave = midi % 12;
                const octave = Math.floor(midi / 12) - 1;
                const posInOctave = notePositions[noteInOctave];

                // G2 (MIDI 43) is at position 4 in octave 2
                const g2Position = 4 + (2 * 7);
                const notePosition = posInOctave + (octave * 7);
                const stepsFromG2 = notePosition - g2Position;

                return 120 - (stepsFromG2 * 10);
            }
        }

        function getNoteHeadFill(duration) {
            // Whole (4) and Half (2) = hollow, Quarter (1) and shorter = filled
            return duration >= 2.0 ? 'white' : 'black';
        }

        function hasStem(duration) {
            // Whole notes have no stem
            return duration < 4.0;
        }

        function needsLedgerLine(y, staffTop, staffBottom) {
            // Need ledger line if above or below staff
            return y > staffBottom || y < staffTop;
        }

        // Determine which hand/staff a note belongs to
        function getHand(note, splitPoint = 60) {
            // If explicitly set in data, use that
            if (note.hand) return note.hand;
            // Otherwise use split point logic
            const midi = Array.isArray(note.midi) ? note.midi[0] : note.midi;
            return midi < splitPoint ? 'left' : 'right';
        }

        // Get note color based on hand
        function getNoteColor(hand, colorCoding = true) {
            if (!colorCoding) return 'black';
            return hand === 'left' ? '#2563eb' : '#000000'; // Blue for left, black for right
        }

        function midiToNoteName(midi) {
            const notes = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
            const octave = Math.floor(midi / 12) - 1;
            const noteIndex = midi % 12;
            return `${notes[noteIndex]}${octave}`;
        }

        // ============================================
        // API FUNCTIONS
        // ============================================
        async function fetchLessons() {
            try {
                const response = await fetch(`${API_BASE_URL}/lessons`);
                if (!response.ok) throw new Error('Failed to fetch lessons');
                return await response.json();
            } catch (error) {
                console.error('Failed to fetch lessons:', error);
                return null;
            }
        }

        async function fetchLesson(lessonId) {
            if (lessonCache[lessonId]) {
                return lessonCache[lessonId];
            }

            try {
                const response = await fetch(`${API_BASE_URL}/lessons/${lessonId}`);
                if (!response.ok) throw new Error('Failed to fetch lesson');
                const apiLesson = await response.json();
                const lesson = convertApiLesson(apiLesson);
                lessonCache[lessonId] = lesson;
                return lesson;
            } catch (error) {
                console.error('Failed to fetch lesson:', error);
                return fallbackLessons[lessonId];
            }
        }

        function convertApiLesson(apiLesson) {
            // API returns: { id, name, description, difficulty, duration_seconds, note_events[], tempo }
            // note_events: { event_index, event_type, note_numbers[], note_names[], chord_name, duration_ms, hand }

            // Calculate ms per beat from tempo (or default to 100 BPM)
            // Formula: ms_per_beat = 60000 / tempo
            const tempo = apiLesson.tempo || 100;
            const msPerBeat = 60000 / tempo; // e.g., 100 BPM = 600ms per beat

            let currentBeat = 0;
            let currentMeasure = 1;
            let measures = [{ number: 1, notes: [] }];

            for (const event of apiLesson.note_events) {
                const durationBeats = event.duration_ms / msPerBeat;

                if (currentBeat >= 4) {
                    currentBeat = 0;
                    currentMeasure++;
                    measures.push({ number: currentMeasure, notes: [] });
                }

                const noteData = {
                    midi: event.note_numbers && event.note_numbers.length > 1
                        ? event.note_numbers
                        : (event.note_numbers ? event.note_numbers[0] : 60),
                    duration: durationBeats,
                    hand: event.hand || 'right'
                };

                if (event.chord_name) {
                    noteData.chord = event.chord_name;
                }

                measures[measures.length - 1].notes.push(noteData);
                currentBeat += durationBeats;
            }

            const totalBeats = apiLesson.note_events.reduce(
                (sum, e) => sum + (e.duration_ms / msPerBeat), 0
            );

            return {
                id: apiLesson.id,
                title: apiLesson.name,
                description: apiLesson.description,
                tempo: 120,
                time_signature: "4/4",
                total_beats: totalBeats,
                difficulty: apiLesson.difficulty,
                measures: measures
            };
        }

