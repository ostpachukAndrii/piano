        // ============================================
        // RENDER SVG STAFF WITH NOTES
        // ============================================
        function renderLesson(lesson) {
            if (!lesson) {
                document.getElementById('lesson-content').innerHTML = '<p class="error">Lesson not found</p>';
                return;
            }

            const calc = new MeasureCalculator(140, 50);
            let trebleNotes = [];
            let bassNotes = [];
            let barLines = [];
            let xPos = 140;
            let eventIndex = 0; // Track event index for practice mode

            // Staff Y positions
            const TREBLE_TOP = 40;
            const TREBLE_BOTTOM = 120;
            const BASS_TOP = 180;
            const BASS_BOTTOM = 260;
            const STAFF_GAP = 60; // Gap between staves

            // Process all notes and calculate positions
            for (const measure of lesson.measures) {
                for (const note of measure.notes) {
                    const isChord = Array.isArray(note.midi);
                    const duration = note.duration;
                    const hand = getHand(note);
                    const currentEventIndex = eventIndex; // Capture for closure

                    if (isChord) {
                        // Chord - multiple notes at same X position
                        const chordX = xPos + (duration * 25);
                        for (const midi of note.midi) {
                            const noteHand = midi < 60 ? 'left' : 'right';
                            const clef = noteHand === 'left' ? 'bass' : 'treble';
                            const baseY = midiToY(midi, clef);
                            const yOffset = clef === 'bass' ? 140 : 0; // Offset for bass staff

                            const noteObj = {
                                x: chordX,
                                y: baseY + yOffset,
                                midi: midi,
                                duration: duration,
                                hand: noteHand,
                                clef: clef,
                                isChord: true,
                                chordName: note.chord,
                                eventIndex: currentEventIndex
                            };

                            if (noteHand === 'left') {
                                bassNotes.push(noteObj);
                            } else {
                                trebleNotes.push(noteObj);
                            }
                        }
                        const barLine = calc.addChord(note.midi.map(() => duration));
                        if (barLine) barLines.push(barLine);
                    } else {
                        // Single note
                        const noteX = xPos + (duration * 25);
                        const clef = hand === 'left' ? 'bass' : 'treble';
                        const baseY = midiToY(note.midi, clef);
                        const yOffset = clef === 'bass' ? 140 : 0;

                        const noteObj = {
                            x: noteX,
                            y: baseY + yOffset,
                            midi: note.midi,
                            duration: duration,
                            hand: hand,
                            clef: clef,
                            isChord: false,
                            eventIndex: currentEventIndex
                        };

                        if (hand === 'left') {
                            bassNotes.push(noteObj);
                        } else {
                            trebleNotes.push(noteObj);
                        }
                        const barLine = calc.addNote(duration);
                        if (barLine) barLines.push(barLine);
                    }

                    eventIndex++; // Increment for next note/chord
                    xPos += duration * 50;
                }
            }

            // Calculate SVG dimensions
            const svgWidth = Math.max(1000, xPos + 100);
            const svgHeight = 320; // Increased for two staves

            // Build SVG content
            let svg = `
                <svg viewBox="0 0 ${svgWidth} ${svgHeight}" class="grand-staff-svg">
                    <!-- Background -->
                    <rect width="${svgWidth}" height="${svgHeight}" fill="white" />
                    
                    <!-- Grand staff brace -->
                    <text x="30" y="180" font-size="180" font-family="serif" transform="scale(0.25, 1.2)">&#x1D114;</text>
                    
                    <!-- TREBLE STAFF (Top) -->
                    <!-- Treble staff lines: Y = 40, 60, 80, 100, 120 -->
                    <line x1="50" y1="40" x2="${svgWidth - 50}" y2="40" stroke="black" stroke-width="1" />
                    <line x1="50" y1="60" x2="${svgWidth - 50}" y2="60" stroke="black" stroke-width="1" />
                    <line x1="50" y1="80" x2="${svgWidth - 50}" y2="80" stroke="black" stroke-width="1" />
                    <line x1="50" y1="100" x2="${svgWidth - 50}" y2="100" stroke="black" stroke-width="1" />
                    <line x1="50" y1="120" x2="${svgWidth - 50}" y2="120" stroke="black" stroke-width="1" />

                    <!-- Treble clef symbol -->
                    <text x="60" y="110" font-size="56" font-family="serif">𝄞</text>

                    <!-- BASS STAFF (Bottom) -->
                    <!-- Bass staff lines: Y = 180, 200, 220, 240, 260 -->
                    <line x1="50" y1="180" x2="${svgWidth - 50}" y2="180" stroke="black" stroke-width="1" />
                    <line x1="50" y1="200" x2="${svgWidth - 50}" y2="200" stroke="black" stroke-width="1" />
                    <line x1="50" y1="220" x2="${svgWidth - 50}" y2="220" stroke="black" stroke-width="1" />
                    <line x1="50" y1="240" x2="${svgWidth - 50}" y2="240" stroke="black" stroke-width="1" />
                    <line x1="50" y1="260" x2="${svgWidth - 50}" y2="260" stroke="black" stroke-width="1" />

                    <!-- Bass clef symbol - dot should be on line 4 (F3, Y=200) -->
                    <text x="60" y="215" font-size="40" font-family="serif">𝄢</text>

                    <!-- Initial bar line (spans both staves) -->
                    <line x1="50" y1="40" x2="50" y2="260" stroke="black" stroke-width="2" />
                    <line x1="120" y1="40" x2="120" y2="260" stroke="black" stroke-width="1" />
            `;

            // Track chord positions for labels
            const chordLabels = new Map();

            // Function to render a note
            function renderNote(note, color) {
                let noteSvg = '';
                const fill = getNoteHeadFill(note.duration);
                const strokeColor = color;
                const fillColor = fill === 'white' ? 'white' : color;
                const rx = note.duration >= 4.0 ? 10 : 8;
                const ry = note.duration >= 4.0 ? 8 : 6;

                // Determine staff boundaries for ledger lines
                const staffTop = note.clef === 'treble' ? TREBLE_TOP : BASS_TOP;
                const staffBottom = note.clef === 'treble' ? TREBLE_BOTTOM : BASS_BOTTOM;

                // Ledger lines if needed
                if (needsLedgerLine(note.y, staffTop, staffBottom)) {
                    // Draw ledger lines between staff and note
                    if (note.y > staffBottom) {
                        // Below staff
                        for (let ly = staffBottom + 20; ly <= note.y; ly += 20) {
                            noteSvg += `<line x1="${note.x - 15}" y1="${ly}" x2="${note.x + 15}" y2="${ly}" stroke="black" stroke-width="1" />`;
                        }
                    } else if (note.y < staffTop) {
                        // Above staff
                        for (let ly = staffTop - 20; ly >= note.y; ly -= 20) {
                            noteSvg += `<line x1="${note.x - 15}" y1="${ly}" x2="${note.x + 15}" y2="${ly}" stroke="black" stroke-width="1" />`;
                        }
                    }
                }

                // Note head - include data-event for practice mode highlighting
                noteSvg += `<ellipse class="note-head" data-midi="${note.midi}" data-event="${note.eventIndex}" cx="${note.x}" cy="${note.y}" rx="${rx}" ry="${ry}" fill="${fillColor}" stroke="${strokeColor}" stroke-width="1.5">
                    <title>${midiToNoteName(note.midi)} (MIDI: ${note.midi}, ${note.hand} hand)</title>
                </ellipse>`;

                // Stem (if not whole note)
                if (hasStem(note.duration)) {
                    // Stem direction: left hand = down, right hand = up
                    const stemUp = note.hand === 'right';
                    const stemX = stemUp ? note.x + 7 : note.x - 7;
                    const stemTop = stemUp ? note.y - 35 : note.y;
                    const stemBottom = stemUp ? note.y : note.y + 35;

                    noteSvg += `<line x1="${stemX}" y1="${stemTop}" x2="${stemX}" y2="${stemBottom}" stroke="${strokeColor}" stroke-width="2" />`;

                    // Flags for eighth notes (0.5) and sixteenth notes (0.25)
                    if (note.duration <= 0.5) {
                        if (stemUp) {
                            // Flag on right side, curving right
                            noteSvg += `<path d="M${stemX},${stemTop} Q${stemX + 15},${stemTop + 5} ${stemX + 8},${stemTop + 15} L${stemX},${stemTop + 10} Z" fill="${strokeColor}"/>`;
                            if (note.duration <= 0.25) {
                                noteSvg += `<path d="M${stemX},${stemTop + 10} Q${stemX + 15},${stemTop + 15} ${stemX + 8},${stemTop + 25} L${stemX},${stemTop + 20} Z" fill="${strokeColor}"/>`;
                            }
                        } else {
                            // Flag on left side, curving left (for downward stems)
                            noteSvg += `<path d="M${stemX},${stemBottom} Q${stemX - 15},${stemBottom - 5} ${stemX - 8},${stemBottom - 15} L${stemX},${stemBottom - 10} Z" fill="${strokeColor}"/>`;
                            if (note.duration <= 0.25) {
                                noteSvg += `<path d="M${stemX},${stemBottom - 10} Q${stemX - 15},${stemBottom - 15} ${stemX - 8},${stemBottom - 25} L${stemX},${stemBottom - 20} Z" fill="${strokeColor}"/>`;
                            }
                        }
                    }
                }

                // Track chord names for labels
                if (note.chordName && !chordLabels.has(note.x)) {
                    chordLabels.set(note.x, note.chordName);
                }

                return noteSvg;
            }

            // Render treble notes (right hand)
            for (const note of trebleNotes) {
                svg += renderNote(note, getNoteColor(note.hand));
            }

            // Render bass notes (left hand)
            for (const note of bassNotes) {
                svg += renderNote(note, getNoteColor(note.hand));
            }

            // Render chord labels above treble staff
            for (const [x, chordName] of chordLabels) {
                svg += `<text x="${x}" y="25" text-anchor="middle" class="chord-label">${chordName}</text>`;
            }

            // Render bar lines (span both staves)
            for (const barLine of barLines) {
                svg += `<line x1="${barLine.xPosition}" y1="40" x2="${barLine.xPosition}" y2="260" stroke="black" stroke-width="2" />`;
            }

            // Final double bar line
            svg += `
                <line x1="${xPos + 25}" y1="40" x2="${xPos + 25}" y2="260" stroke="black" stroke-width="2" />
                <line x1="${xPos + 30}" y1="40" x2="${xPos + 30}" y2="260" stroke="black" stroke-width="4" />
            `;

            svg += '</svg>';

            // Update DOM
            document.getElementById('lesson-content').innerHTML = `
                <div class="lesson-header">
                    <h2>${lesson.title}</h2>
                    <p>${lesson.description}</p>
                </div>
                <div class="grand-staff-container">
                    ${svg}
                </div>
                <div class="lesson-footer">
                    <p class="stat-badge">⏱️ Tempo: ${lesson.tempo} BPM</p>
                    <p class="stat-badge">🎼 Time: ${lesson.time_signature}</p>
                    <p class="stat-badge">📊 Beats: ${Math.round(lesson.total_beats)}</p>
                    <p class="stat-badge">🎵 Notes: ${trebleNotes.length + bassNotes.length}</p>
                    <p class="stat-badge">🎹 Right: ${trebleNotes.length} | Left: ${bassNotes.length}</p>
                    <p class="stat-badge">📏 Measures: ${lesson.measures.length}</p>
                    ${lesson.difficulty ? `<p class="stat-badge">📈 Level: ${lesson.difficulty}</p>` : ''}
                </div>
            `;
        }

        // ============================================
        // UI STATUS UPDATES
        // ============================================
        function updateApiStatus(status) {
            const statusEl = document.getElementById('api-status');
            statusEl.className = 'api-status ' + status;
            switch (status) {
                case 'connected':
                    statusEl.textContent = 'API Connected';
                    break;
                case 'disconnected':
                    statusEl.textContent = 'Offline Mode';
                    break;
                case 'loading':
                    statusEl.textContent = 'Connecting...';
                    break;
            }
        }

        function populateLessonSelector(lessons, useFallback = false) {
            const selector = document.getElementById('lesson-select');
            selector.innerHTML = '';

            if (useFallback) {
                for (const [id, lesson] of Object.entries(fallbackLessons)) {
                    const option = document.createElement('option');
                    option.value = id;
                    option.textContent = lesson.title;
                    selector.appendChild(option);
                }
            } else {
                for (const lesson of lessons) {
                    const option = document.createElement('option');
                    option.value = lesson.id;
                    option.textContent = lesson.name;
                    selector.appendChild(option);
                }
            }

            selector.disabled = false;
        }

        // ============================================
        // INITIALIZATION
        // ============================================
        async function init() {
            updateApiStatus('loading');

            // Initialize MIDI controls
            initMidiControls();

            // Initialize practice controls
            initPracticeControls();

            // Try to connect to API
            const lessons = await fetchLessons();

            if (lessons && lessons.length > 0) {
                apiConnected = true;
                updateApiStatus('connected');
                populateLessonSelector(lessons);

                // Load first lesson
                const firstLesson = await fetchLesson(lessons[0].id);
                currentLesson = firstLesson;
                renderLesson(firstLesson);
                updatePracticeButtonState();
            } else {
                apiConnected = false;
                updateApiStatus('disconnected');
                populateLessonSelector(null, true);

                // Load fallback lesson
                currentLesson = fallbackLessons.alphabet;
                renderLesson(fallbackLessons.alphabet);
                updatePracticeButtonState();
            }

            // Handle lesson selection
            document.getElementById('lesson-select').addEventListener('change', async (e) => {
                document.getElementById('lesson-content').innerHTML = '<p class="loading">Loading lesson...</p>';

                // Stop practice if running
                if (practiceActive) {
                    stopPractice();
                }

                if (apiConnected) {
                    const lesson = await fetchLesson(e.target.value);
                    currentLesson = lesson;
                    renderLesson(lesson);
                } else {
                    currentLesson = fallbackLessons[e.target.value];
                    renderLesson(fallbackLessons[e.target.value]);
                }

                updatePracticeButtonState();
            });

            // Cleanup on page unload - disconnect MIDI to release the port
            window.addEventListener('beforeunload', () => {
                if (midiConnected) {
                    // Use sendBeacon for reliable delivery during page unload
                    navigator.sendBeacon(`${API_BASE_URL}/midi/disconnect`);
                }
                if (midiWebSocket) {
                    midiWebSocket.close();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>

</html>